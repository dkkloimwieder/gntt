{
    "name": "ganttss",
    "version": "1.0.3",
    "description": "",
    "main": "dist/ganttss.es.js",
    "module": "dist/ganttss.es.js",
    "types": "./dist/types/index.d.ts",
    "type": "module",
    "scripts": {
        "dev": "vite --config config/vite/solid.js",
        "build": "vite build --config config/vite/solid.js && tsc -p tsconfig.build.json",
        "build:demo": "vite build --config config/vite/demo.js",
        "preview:demo": "vite preview --config config/vite/demo.js --port 4173",
        "generate:calendar": "tsx src/scripts/generateCalendar.ts",
        "generate:topology": "tsx src/scripts/generateTopology.ts",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "tsx server/db/migrate.ts",
        "db:seed": "tsx server/db/seed.ts",
        "db:setup": "pnpm db:migrate && pnpm db:seed",
        "dev:server": "tsx watch server/index.ts",
        "dev:all": "concurrently -k -n vite,server -c blue,green \"pnpm dev\" \"pnpm dev:server\"",
        "bench": "tsx benchmarks/constraint/runBenchmarks.ts",
        "bench:all": "tsx benchmarks/constraint/runBenchmarks.ts --all",
        "bench:scaling": "tsx benchmarks/constraint/scalingTest.ts",
        "bench:browser": "./benchmarks/scripts/run-comprehensive.sh",
        "bench:browser:virt": "./benchmarks/scripts/run-virt-comprehensive.sh",
        "bench:browser:matrix": "./benchmarks/scripts/run-virt.sh",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "oxlint src tests server benchmarks/constraint config/vite vitest.config.ts",
        "prettier": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"server/**/*.ts\" \"benchmarks/constraint/**/*.ts\" \"benchmarks/scripts/**/*.mjs\" \"config/vite/**/*.js\" vitest.config.ts .oxlintrc.json",
        "prettier-check": "prettier --check \"src/**/*.{js,jsx,ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"server/**/*.ts\" \"benchmarks/constraint/**/*.ts\" \"benchmarks/scripts/**/*.mjs\" \"config/vite/**/*.js\" vitest.config.ts .oxlintrc.json"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dkkloimwieder/gntt.git"
    },
    "files": [
        "src",
        "!src/demo",
        "!src/entries",
        "!src/scripts",
        "!src/data/generated",
        "dist",
        "README.md",
        "CHANGELOG.md"
    ],
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/ganttss.es.js"
        }
    },
    "keywords": [
        "gantt",
        "svg",
        "simple gantt",
        "project timeline",
        "interactive gantt",
        "project management"
    ],
    "author": "",
    "license": "MIT",
    "bugs": {
        "url": ""
    },
    "homepage": "",
    "devDependencies": {
        "@hono/node-server": "^2.1.11",
        "@solid-primitives/raf": "^4.0.0",
        "@solidjs/vite-plugin": "^3.0.1",
        "@solidjs/web": "^2.0.4",
        "@types/better-sqlite3": "^9.6.0",
        "@types/node": "^26.6.11",
        "better-sqlite3": "^13.2.0",
        "concurrently": "^10.0.7",
        "drizzle-kit": "^0.31.11",
        "drizzle-orm": "^0.45.4",
        "hono": "^4.13.23",
        "jsdom": "^31.0.1",
        "oxlint": "^1.95.0",
        "postcss-nesting": "^14.0.3",
        "prettier": "3.10.1",
        "solid-js": "^2.0.4",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vite": "^8.4.0",
        "vitest": "^5.1.2"
    },
    "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975",
    "engines": {
        "node": ">=22.12.0"
    },
    "peerDependencies": {
        "@solidjs/web": "^2.0.4",
        "solid-js": "^2.0.4"
    }
}
